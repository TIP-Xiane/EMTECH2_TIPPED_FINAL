DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=postgres://tipped_app:replace-with-your-local-password@127.0.0.1:5432/tipped

# Google Cloud Web OAuth client: keep secret on the server only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/api/auth/google/callback/
# Optional exact Google Workspace hd domains; empty means manual eligibility approval.
GOOGLE_ALLOWED_DOMAINS=
